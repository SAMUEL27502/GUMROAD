# Database (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tradebib?schema=public"

# Supabase Auth (required for production auth / OAuth / JWT sessions)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payments (optional)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
PAYPAL_CLIENT_ID=""

# Notes:
# 1. In Supabase Dashboard → Authentication → Providers, enable Email, Google, GitHub.
# 2. Add redirect URL: {NEXT_PUBLIC_APP_URL}/auth/callback
# 3. Without real Supabase keys the app runs in demo auth mode (httpOnly session cookie).
