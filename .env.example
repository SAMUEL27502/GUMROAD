# Database (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tradebib?schema=public"

# Supabase Auth (required for production auth / OAuth / JWT sessions)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Payments (Stripe subscriptions)
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""
STRIPE_PRICE_ELITE_MONTHLY=""
STRIPE_PRICE_ELITE_YEARLY=""
PAYPAL_CLIENT_ID=""

# Notes:
# 1. In Supabase Dashboard → Authentication → Providers, enable Email, Google, GitHub.
# 2. Add redirect URL: {NEXT_PUBLIC_APP_URL}/auth/callback
# 3. Without real Supabase keys the app runs in demo auth mode (httpOnly session cookie).
# 4. Without Stripe keys, /billing runs in demo mode (Checkout/Portal simulated).
# 5. Stripe webhook endpoint: {NEXT_PUBLIC_APP_URL}/api/stripe/webhook
